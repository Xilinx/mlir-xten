@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# The exported targets carry MLIR/LLVM targets in their INTERFACE_LINK_LIBRARIES.
# Those are IMPORTED targets in a standalone mlir-xten build, so they are written
# into mlir-xtenTargets.cmake by name only and must be re-created here before the
# targets file is included.
if(NOT TARGET MLIRIR AND NOT MLIR_XTEN_SKIP_MLIR_DEPENDENCY)
  find_dependency(MLIR)
endif()

set(MLIR_XTEN_ENABLE_CONVERSION_PASSES @MLIR_XTEN_ENABLE_CONVERSION_PASSES@)

include("${CMAKE_CURRENT_LIST_DIR}/mlir-xtenTargets.cmake")

set_and_check(MLIR_XTEN_INCLUDE_DIR "@PACKAGE_XTEN_INSTALL_INCLUDEDIR@")
set(MLIR_XTEN_INCLUDE_DIRS "${MLIR_XTEN_INCLUDE_DIR}")

set(MLIR_XTEN_CAPI_LIBRARY xten::XTenCAPI)

set(MLIR_XTEN_DIALECT_TARGETS xten::XTenNNInterfaces xten::XTenNNDialect
                              xten::XTenNNTransforms)

set(MLIR_XTEN_LIBRARIES ${MLIR_XTEN_DIALECT_TARGETS})
if(MLIR_XTEN_ENABLE_CONVERSION_PASSES)
  list(APPEND MLIR_XTEN_LIBRARIES xten::XTenConversionPasses)
endif()

set(MLIR_XTEN_EXPORTED_TARGETS ${MLIR_XTEN_LIBRARIES}
                               ${MLIR_XTEN_CAPI_LIBRARY})

check_required_components(mlir-xten)
